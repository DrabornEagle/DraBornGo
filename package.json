{
  "name": "draborngo",
  "main": "expo/AppEntry",
  "version": "0.0.14",
  "scripts": {
    "start": "node ./node_modules/expo/bin/cli start",
    "web": "node ./node_modules/expo/bin/cli start --web",
    "doctor": "npx expo-doctor@latest",
    "expo:fix": "npx expo install --fix",
    "dkd:start:go": "node ./node_modules/expo/bin/cli start --go --lan --clear",
    "dkd:start:dev": "node ./node_modules/expo/bin/cli start --dev-client --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./node_modules/expo/bin/cli start --android",
    "ios": "node ./node_modules/expo/bin/cli start --ios",
    "lint": "node ./node_modules/expo/bin/cli lint",
    "push:dev": "npx eas-cli build --profile development --platform android",
    "push:prod": "npx eas-cli build --profile production --platform android",
    "lint:src": "eslint src App.js",
    "scan:hygiene": "node ./scripts/local/runtime-hygiene-scan.js",
    "quality:local": "npm run scan:hygiene",
    "release:verify": "bash ./scripts/release-signoff.sh .",
    "release:manifest": "bash ./scripts/release-manifest.sh .",
    "release:archive": "bash ./scripts/release-safe-archive.sh .",
    "play:final-audit": "bash ./scripts/dkd_play_console_final_audit.sh .",
    "postinstall": "node ./scripts/dkd_restore_public_env.mjs && node ./scripts/dkd_clean_android_dependency_manifests.js",
    "dkd:clean-android-manifests": "node ./scripts/dkd_clean_android_dependency_manifests.js",
    "dkd:play-risk-scan": "node ./scripts/dkd_play_risk_scan.js",
    "dkd:lock:sync": "npm install --package-lock-only --ignore-scripts",
    "env:restore": "node ./scripts/dkd_restore_public_env.mjs",
    "prestart": "npm run env:restore",
    "preandroid": "npm run env:restore",
    "prebuild": "npm run env:restore",
    "preexport": "npm run env:restore",
    "dkd:verify-v0.0.14": "node ./scripts/dkd_verify_release_identity.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rnmapbox/maps": "^10.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~57.0.8",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "mapbox-gl": "^2.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "^57.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
