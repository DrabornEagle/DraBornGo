{
  "name": "draborngo",
  "main": "expo/AppEntry",
  "version": "0.0.6",
  "scripts": {
    "start": "expo start",
    "dkd:syntax:check": "node tools/dkd_syntax_check.mjs",
    "dkd:start:go": "npm run dkd:syntax:check && expo start --go --tunnel --clear",
    "android": "expo start --android",
    "dkd:deps:fix": "npx expo install --fix",
    "quality:local": "npm run dkd:syntax:check && npx expo install --check && npx expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-splash-screen": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
